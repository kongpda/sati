{
  "name": "agent-sati",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "turbo run build",
    "local": "bash scripts/local.sh",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "node scripts/e2e.mjs",
    "test:ui": "pnpm --filter @sati/e2e test:ui",
    "bench": "turbo run bench",
    "lint": "biome check .",
    "format": "biome check --write .",
    "knip": "knip",
    "changeset": "changeset",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "knip": "6.43.0",
    "tsdown": "0.23.4",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-67mh-4wv8-2f99"
      ]
    }
  }
}
