{
  "name": "@kongpda/sati",
  "version": "0.1.0",
  "description": "Local-first memory, task and feature manager for AI coding agents",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/kongpda/sati#readme",
  "bugs": {
    "url": "https://github.com/kongpda/sati/issues"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "cursor",
    "mcp",
    "task-manager",
    "cli",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongpda/sati.git",
    "directory": "packages/cli"
  },
  "bin": {
    "sati": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-ui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node bench/bench.ts"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@sati/core": "workspace:*",
    "@sati/mcp": "workspace:*",
    "@sati/store-sqlite": "workspace:*",
    "@sati/sync": "workspace:*",
    "@sati/ui": "workspace:*",
    "@types/micromatch": "4.0.10",
    "citty": "0.2.2",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "micromatch": "4.0.8",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  }
}
