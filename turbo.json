{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@kongpda/sati#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"],
      "passThroughEnv": ["SATI_KEEP_TMP"]
    },
    "bench": {
      "dependsOn": ["build"],
      "passThroughEnv": ["BENCH_FACTOR", "SATI_KEEP_TMP"],
      "cache": false
    }
  }
}
